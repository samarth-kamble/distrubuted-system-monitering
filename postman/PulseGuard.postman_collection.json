        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", response.accessToken);",
                  "    console.log(\"Access Token successfully stored in environment as 'jwt_token'.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
