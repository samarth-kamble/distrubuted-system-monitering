# Postgres Database Connection URL (Target Postgres service inside Docker network)
DATABASE_URL="postgresql://pulseguard:password@postgres:5432/pulseguard?schema=public"

# Redis Server Configuration
REDIS_HOST="redis"
REDIS_PORT="6379"

# API Server Configuration
PORT="3000"
NODE_ENV="development" # Set to 'production' in live builds to mask stack traces and enforce secure cookie flags
JWT_SECRET="pulseguard-super-secret-key-replace-this-in-production"
CORS_ORIGIN="*"
